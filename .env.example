# PostgreSQL
POSTGRES_DB=breezio
POSTGRES_USER=breezio
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://breezio:change-me@127.0.0.1:5432/breezio

# MQTT
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# Object storage
RUSTFS_ACCESS_KEY=breezio
RUSTFS_SECRET_KEY=change-me
RUSTFS_PUBLIC_URL=http://127.0.0.1:9000

# Backend authentication
API_TOKEN=replace-with-service-token
BREEZIO_AUTH_SECRET=replace-with-random-signing-secret
BREEZIO_BOOTSTRAP_PASSWORD=replace-with-initial-admin-password

# Local service addresses
BREEZIO_BACKEND_URL=http://127.0.0.1:8000
BREEZIO_INFERENCE_URL=http://127.0.0.1:8100
BREEZIO_CORS_ORIGINS=http://127.0.0.1:5173

# Optional OpenAI-compatible LLM credential. Endpoint and model are selected
# in the application settings.
BREEZIO_LLM_API_KEY=

# Optional camera source
CAMERA_SOURCE_URI=rtsp://192.0.2.72

# ESP32-S3 compile-time settings
BREEZIO_WIFI_SSID=breezio-lab
BREEZIO_WIFI_FALLBACK_SSID=breezio-lab-2g
BREEZIO_WIFI_PASS=change-me
BREEZIO_GATEWAY_HOST=192.0.2.100
BREEZIO_GATEWAY_PORT=5568
